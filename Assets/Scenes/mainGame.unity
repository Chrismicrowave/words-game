  m_text: "apple \u2014 \u82F9(ping) \u679C(guo)\ngarden \u2014 \u82B1(hua) \u56ED(yuan)\nseed
    \u2014 \u79CD(zhong) \u5B50(zi)\nsoil \u2014 \u571F(tu) \u58E4(rang)\nwater \u2014
    \u6D47(jiao) \u6C34(shui)\nleaf \u2014 \u53F6(ye) \u5B50(zi)\nflower \u2014 \u82B1(hua)
    \u6735(duo)\nwindow \u2014 \u7A97(chuang) \u6237(hu)\nmorning \u2014 \u65E9(zao)
    \u4E0A(shang)\nticket \u2014 \u8F66(che) \u7968(piao)\nstation \u2014 \u8F66(che)
    \u7AD9(zhan)\nplatform \u2014 \u7AD9(zhan) \u53F0(tai)\ntransfer \u2014 \u6362(huan)
    \u4E58(cheng)\nmarket \u2014 \u5E02(shi) \u573A(chang)\nreceipt \u2014 \u6536(shou)
    \u636E(ju)\nborrow \u2014 \u501F(jie) \u7528(yong)\nreturn \u2014 \u5F52(gui)
    \u8FD8(huan)\nquiet \u2014 \u5B89(an) \u9759(jing)"
